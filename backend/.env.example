# VIT Mithra Attendance Portal - Backend Environment Configuration Template
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# =============================================================================
# 1. APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
PORT=8000
DEBUG=True

# =============================================================================
# 2. DATABASE & FIREBASE CONFIGURATION
# =============================================================================
# NOTE: If Firebase credentials are left as placeholders (starting with "your_")
# or left blank, the portal automatically runs in OFFLINE PERSISTENCE MODE using
# backend/data/local_firestore.json. No Firebase setup is needed for local dev!
#
# To connect to live Google Cloud / Firebase Firestore, use EITHER Option A OR Option B:

# --- Option A: Service Account JSON File (Recommended for local dev) ---
# Download serviceAccountKey.json from:
#   Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Place it inside the backend/ directory (it is git-ignored) and uncomment:
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# --- Option B: Environment Variables (Recommended for Docker / Cloud Run / Vercel) ---
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Note: Ensure the private key retains its \n line breaks and is wrapped in double quotes:
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# =============================================================================
# 3. BACKEND API KEY (FOR AUTOMATED & SERVICE-TO-SERVICE TASKS)
# =============================================================================
# Header: X-API-Key. Generate a secure random string (e.g. openssl rand -hex 32)
API_KEY=your_generated_backend_api_key_secret_here

# =============================================================================
# 4. CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# 5. RATE LIMITING (SLOWAPI)
# =============================================================================
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_BULK=30/minute
RATE_LIMIT_REPORTS=15/minute

